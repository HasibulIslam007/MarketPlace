DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
JWT_SECRET=replace_with_a_long_random_secret

# SSLCOMMERZ sandbox credentials. Set SSLCOMMERZ_IS_LIVE=true only in production.
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_LIVE=false

CLIENT_URL=http://localhost:3000
# Use a public HTTPS URL (for example an ngrok URL) for sandbox callbacks.
SERVER_PUBLIC_URL=https://your-public-server-url.example.com