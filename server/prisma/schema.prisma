generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("customer")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  price       Decimal
  stock       Int
  imageUrl    String?
  categoryId  Int?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  orderItems  OrderItem[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  sortOrder Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model HomePageSettings {
  id              Int      @id @default(1)
  heroImageUrl    String?
  heroImageAlt    String   @default("Featured sneaker")
  heroBadge       String   @default("New Collection 2032")
  heroTitle       String   @default("Step Into")
  heroTitleAccent String   @default("Your Best")
  heroSubtitle    String   @default("Premium footwear for every step of your journey. From athletic performance to everyday comfort.")
  discountTop     String   @default("UP TO")
  discountValue   String   @default("40%")
  discountBottom  String   @default("OFF")
  card1Icon       String   @default("truck")
  card1Title      String   @default("Free Shipping")
  card1Subtitle   String   @default("Orders over $75")
  card2Icon       String   @default("refresh")
  card2Title      String   @default("Easy Returns")
  card2Subtitle   String   @default("60-day guarantee")
  updatedAt       DateTime @updatedAt
}

model Order {
  id               Int         @id @default(autoincrement())
  user             User        @relation(fields: [userId], references: [id])
  userId           Int
  status           String      @default("pending")
  total            Decimal
  currency         String      @default("BDT")
  tranId           String?     @unique
  paymentGateway   String?
  validationId     String?
  bankTranId       String?
  paidAt           DateTime?
  customerName     String      @default("")
  customerPhone    String      @default("")
  shippingAddress  String      @default("")
  shippingCity     String      @default("")
  shippingPostcode String      @default("")
  items            OrderItem[]
  createdAt        DateTime    @default(now())
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  order        Order   @relation(fields: [orderId], references: [id])
  orderId      Int
  product      Product @relation(fields: [productId], references: [id])
  productId    Int
  quantity     Int
  priceAtOrder Decimal
}
